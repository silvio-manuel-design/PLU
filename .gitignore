# Secrets & Deployment
DEPLOYMENT.md

# Build & Dependencies
**/dist/
**/node_modules/

# Große Medien & Fremd-Software (lokal vorhanden, nicht versioniert)
# Videos werden vom Produktiv-Server ausgeliefert und nicht versioniert,
# um die Repository-Größe zu begrenzen.
tutorials/pansonic-video-lab/assets/videos/library/*.mp4
tutorials/pansonic-video-lab/assets/videos/library/*.webm
*.mp4
# Ausnahme: js-classic Kapitel-Medien (P9R1)
!tutorials/js-classic/assets/media/**
*.webm
*.zip
*.exe

# OS-Müll
.DS_Store
Thumbs.db
desktop.ini

# Test-/Temp-Reste
test_heredoc.txt
*.bak
*.tmp
*~

# Python
__pycache__/
*.pyc
*.pyo

# Logs
npm-debug.log*
yarn-debug.log*

# Editor settings (personal)
.vscode/settings.json
.idea/
*.swp
*.swo

tutorials/js-classic/admin/config.php
