/* Reveal Box */
.usecase-reveal {
  max-width: 1200px;
  margin: 50px auto 0;
  padding: 40px;
  background: linear-gradient(135deg, rgba(144, 169, 85, 0.1) 0%, rgba(144, 169, 85, 0.05) 100%);
  border-radius: 24px;
  border: 1px solid rgba(144, 169, 85, 0.2);
  text-align: center;
  display: none;
  position: relative;
  overflow: hidden;
}

.usecase-reveal::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, #90A955, #F4A261, #90A955);
}

.usecase-reveal.show {
  display: block;
  animation: slideUpFade 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.usecase-reveal i {
  font-size: 3.5rem;
  color: #90A955;
  margin-bottom: 20px;
  display: block;
}

.usecase-reveal h3 {
  font-family: 'Manrope', sans-serif;
  font-size: 1.6rem;
  color: #2A363B;
  margin-bottom: 16px;
}

.usecase-reveal p {
  color: #5D4037;
  line-height: 1.8;
  font-size: 1.05rem;
  max-width: 700px;
  margin: 0 auto;
}

@media (max-width: 768px) {
  .usecase-grid {
    grid-template-columns: 1fr;
    max-width: 400px;
    gap: 20px;
  }
  
  .usecase-card {
    padding: 32px 24px;
  }
  
  .usecase-reveal {
    margin: 30px 16px 0;
    padding: 28px 20px;
  }
}

