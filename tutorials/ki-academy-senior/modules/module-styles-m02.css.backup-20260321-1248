/* ============================================
   USE CASE CARDS - 3D Floating
   ============================================ */
.usecase-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
  max-width: 1100px;
  margin: 0 auto;
  perspective: 1000px;
}

.usecase-card {
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(255, 255, 255, 0.5);
  border-radius: 24px;
  padding: 40px 28px;
  text-align: center;
  cursor: pointer;
  transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 
    0 4px 20px rgba(0,0,0,0.05),
    0 20px 40px rgba(0,0,0,0.03);
  backdrop-filter: blur(20px);
  position: relative;
  transform-style: preserve-3d;
}

.usecase-card::before {
  content: '';
  position: absolute;
  inset: -1px;
  border-radius: 24px;
  background: linear-gradient(135deg, rgba(244, 162, 97, 0.3), rgba(144, 169, 85, 0.3));
  opacity: 0;
  transition: opacity 0.4s;
  z-index: -1;
}

.usecase-card:hover {
  transform: translateY(-12px) rotateX(5deg);
  box-shadow: 
    0 20px 60px rgba(244, 162, 97, 0.2),
    0 40px 80px rgba(0,0,0,0.1);
}

.usecase-card:hover::before {
  opacity: 1;
}

.usecase-card.active {
  border-color: #90A955;
  background: rgba(144, 169, 85, 0.1);
  transform: translateY(-8px);
  box-shadow: 0 20px 60px rgba(144, 169, 85, 0.25);
}

.usecase-card-icon {
  width: 70px;
  height: 70px;
  border-radius: 20px;
  background: linear-gradient(135deg, #F4A261 0%, #E76F51 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24px;
  box-shadow: 0 10px 30px rgba(244, 162, 97, 0.3);
  transition: all 0.4s;
}

.usecase-card:hover .usecase-card-icon {
  transform: scale(1.1) rotate(-5deg);
  box-shadow: 0 15px 40px rgba(244, 162, 97, 0.4);
}

.usecase-card-icon i {
  font-size: 2.2rem;
  color: white;
}

.usecase-card h4 {
  font-family: 'Manrope', sans-serif;
  font-size: 1.25rem;
  color: #2A363B;
  margin-bottom: 12px;
  font-weight: 700;
}

.usecase-card p {
  font-size: 0.95rem;
  color: #6B7280;
  margin: 0;
  line-height: 1.6;
}

/* Dark section cards */
.section-mobility .usecase-card {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(255, 255, 255, 0.1);
}

.section-mobility .usecase-card:hover {
