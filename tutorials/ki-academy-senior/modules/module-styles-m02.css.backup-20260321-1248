/* ============================================
   BACK TO TOP BUTTON (exakt wie Modul 01)
   ============================================ */
.back-to-top {
  position: fixed;
  bottom: 100px;
  right: 30px;
  width: 50px;
  height: 50px;
  background: #F4A261;
  border: none;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 20px rgba(244, 162, 97, 0.4);
  opacity: 0;
  visibility: hidden;
  transform: translateY(20px);
  transition: all 0.3s ease;
  z-index: 999;
}

.back-to-top.is-visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.back-to-top:hover {
  background: #E76F51;
  transform: translateY(-3px);
}

.back-to-top svg {
  color: white;
  width: 24px;
  height: 24px;
}

@media (max-width: 768px) {
  .back-to-top {
    display: none;
  }
}

[data-theme="dark"] .back-to-top {
  background: #F4A261;
  color: #1A202C;
}

[data-theme="dark"] .back-to-top:hover {
  background: #E76F51;
}
/* Print */
@media print {
  .bottom-nav-senior {
    display: none !important;
  }
  
  body.module-page {
    padding-bottom: 0;
  }
}
