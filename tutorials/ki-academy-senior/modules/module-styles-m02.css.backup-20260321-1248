/* ============================================
   HERO M02 - Everyday Competence
   ============================================ */
.m02-hero {
  min-height: 100vh;
  padding: 140px 0 80px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.m02-hero::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 200px;
  background: linear-gradient(to top, #FDFCF7 0%, rgba(253, 252, 247, 0.8) 40%, transparent 100%);
  z-index: 2;
  pointer-events: none;
}

[data-theme="dark"] .m02-hero::after {
  background: linear-gradient(to top, #1a1d24 0%, rgba(26, 29, 36, 0.8) 40%, transparent 100%);
}

.m02-hero-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.m02-hero-bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transform: scale(1.1);
}

.m02-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    rgba(42, 54, 59, 0.92) 0%,
    rgba(42, 54, 59, 0.78) 40%,
    rgba(244, 162, 97, 0.3) 100%
  );
  z-index: 1;
}

.m02-hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 850px;
  margin: 0 auto;
  padding: 0 24px;
}

.m02-hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 20px;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(20px);
  border-radius: 50px;
  color: rgba(255, 255, 255, 0.95);
  font-size: 0.9rem;
  font-weight: 500;
  margin-bottom: 28px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
}

.m02-hero-title {
  font-family: 'Manrope', sans-serif;
  font-size: clamp(2.2rem, 5.5vw, 4rem);
  font-weight: 800;
  color: #ffffff;
  line-height: 1.1;
  margin-bottom: 24px;
  text-shadow: 0 4px 40px rgba(0, 0, 0, 0.4);
  letter-spacing: -0.02em;
}

.m02-hero-title em {
  color: #F4A261;
  font-style: normal;
  position: relative;
}

.m02-hero-title em::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 8px;
  background: linear-gradient(90deg, transparent, #F4A261, transparent);
  opacity: 0.5;
}

.m02-hero-subtitle {
  font-size: clamp(1.1rem, 2.2vw, 1.35rem);
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.7;
  margin-bottom: 40px;
  max-width: 650px;
  margin-left: auto;
  margin-right: auto;
  font-weight: 300;
}

.m02-hero-cta {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 18px 36px;
  background: linear-gradient(135deg, #F4A261 0%, #E76F51 50%, #F4A261 100%);
  background-size: 200% 200%;
  color: white;
  font-weight: 600;
  font-size: 1.1rem;
  border-radius: 50px;
  text-decoration: none;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 10px 40px rgba(244, 162, 97, 0.4);
  border: 2px solid rgba(255, 255, 255, 0.1);
  position: relative;
  overflow: hidden;
}

.m02-hero-cta::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transform: translateX(-100%);
  transition: transform 0.6s;
}

.m02-hero-cta:hover {
  transform: translateY(-4px) scale(1.02);
  box-shadow: 0 20px 60px rgba(244, 162, 97, 0.5);
  background-position: 100% 100%;
}

.m02-hero-cta:hover::before {
  transform: translateX(100%);
}

.m02-hero-cta i {
  transition: transform 0.3s ease;
}

.m02-hero-cta:hover i {
  transform: translateY(4px);
}

@media (max-width: 768px) {
  .m02-hero {
    min-height: 100vh;
    padding: 100px 0 40px;
  }
  
  .m02-hero-title {
    font-size: 2.2rem;
  }
  
  .m02-hero-cta {
    padding: 16px 28px;
    font-size: 1rem;
  }
}

